# Copy this file to .env on the production server and replace every placeholder.
# Never commit the completed .env file.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=fmis.example.gov.ph
DJANGO_CSRF_TRUSTED_ORIGINS=https://fmis.example.gov.ph
DJANGO_BEHIND_HTTPS_PROXY=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
FMIS_REQUIRE_MFA=True

DB_ENGINE=mysql
MYSQL_DATABASE=fmis
MYSQL_USER=fmis_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_CONN_MAX_AGE=60
MYSQL_ALLOW_LEGACY_MARIADB=False

EMAIL_HOST=smtp.example.gov.ph
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=FMIS <noreply@example.gov.ph>

PUBLIC_PAGE_CACHE_SECONDS=300
REMEMBER_LOGIN_DAYS=7
FMIS_RELEASE_VERSION=replace-with-release-tag
FMIS_FIELD_BASE_URL=https://fmis.example.gov.ph
FMIS_PREWARM_ON_START=True
FMIS_LOG_ROOT=C:/FMIS/logs
FMIS_LOG_LEVEL=INFO
FMIS_MIN_FREE_DISK_GB=5

# Required before production turnover and automatic backup scheduling.
FMIS_BACKUP_ROOT=C:/FMIS/backups
FMIS_BACKUP_ENCRYPTION_KEY=replace-with-output-from-generate_backup_key
BACKUP_AZURE_CONTAINER_URL=replace-with-private-https-container-sas-url
MARIADB_DUMP_PATH=C:/Program Files/MariaDB 10.11/bin/mariadb-dump.exe
FMIS_BACKUP_SCHEDULER_CONFIGURED=False
