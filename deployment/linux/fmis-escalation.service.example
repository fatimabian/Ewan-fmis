[Unit]
Description=FMIS service request escalation check
After=network.target mariadb.service

[Service]
Type=oneshot
User=fmis
Group=fmis
WorkingDirectory=/srv/fmis/app
EnvironmentFile=/etc/fmis/fmis.env
ExecStart=/srv/fmis/venv/bin/python manage.py process_service_escalations
NoNewPrivileges=true
PrivateTmp=true

