<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to the IIS FMIS site root as web.config after installing:
  URL Rewrite 2 and Application Request Routing (ARR) with proxy enabled.
  The Django/Waitress service must listen only on 127.0.0.1:8080.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 25 MiB outer limit; application validation remains authoritative. -->
        <requestLimits maxAllowedContentLength="26214400" />
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Block private FMIS media" stopProcessing="true">
          <match url="^media/(farm_documents|farmer_photos|parcel_photos|account_profiles)(/.*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Reverse proxy to FMIS" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
