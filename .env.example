# Copy to .env (Git ignores .env). Never commit real keys.

# Scan & Auto-Fill (OCR)
# openrouter (default), gemini (direct Google API) or sample (canned demo data, no key needed)
OCR_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Comma separated, tried in order. Choose them after running: python manage.py ocr_compare <dummy form images>
# OpenRouter example format: vendor/model-name:free   Gemini example format: model-name
OCR_MODELS=
OCR_DAILY_LIMIT=40
OCR_TIMEOUT_SECONDS=45
OCR_CONFIDENCE_THRESHOLD=0.75
# Private store for uploaded form images (defaults to ./private_media)
# FMIS_PRIVATE_MEDIA_ROOT=

# Add Farmer RSBSA scan reader: auto (uses OpenRouter/Gemini when configured), ocr, or openai
RSBSA_SCAN_ENGINE=auto
